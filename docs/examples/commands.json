    "schema": {
      "argv": [
        "schema",
        "jira comment add"
      ],
      "arguments": {
        "command": "jira comment add"
      },
      "input": null,
      "note": "The `error` schema is abbreviated here; the real output contains the full error envelope schema shared by every command.",
      "success": {
        "ok": true,
        "data": {
          "schema_version": 1,
          "command": "jira comment add",
          "summary": "Add a plain-text comment from --body, a file, or stdin, after checking the issue exists and you may comment.",
          "usage": "yojo jira comment add KEY (--body TEXT | --body-file FILE|-)",
          "example": "yojo --json jira comment add PROJ-123 --body 'Fixed in build 42.'",
          "arguments": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*(?![\\s\\S])"
              },
              "body": {
                "type": "string",
                "minLength": 1
              },
              "body_file": {
                "type": "string",
                "minLength": 1,
                "description": "Path to a plain UTF-8 text file (not JSON, max 1 MiB), or '-' for stdin."
              }
            },
            "additionalProperties": false,
            "required": [
              "key"
            ],
            "oneOf": [
              {
                "required": [
                  "body"
                ]
              },
              {
                "required": [
                  "body_file"
                ]
              }
            ]
          },
          "input": null,
          "success": {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "description": "Link to open in a browser."
                  },
                  "comment_id": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "key",
                  "url",
                  "comment_id"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "ok",
              "data"
            ]
          },
          "error": {
            "type": "object",
            "description": "Error envelope schema (abbreviated)."
          },
          "error_codes": [
            "auth_failed",
            "auth_missing",
            "config_invalid",
            "config_legacy",
            "config_not_found",
            "forbidden",
            "input_invalid",
            "internal_error",
            "interrupted",
            "keyring_unavailable",
            "metadata_incomplete",
            "not_found",
            "outcome_unknown",
            "rate_limited",
            "redirect_refused",
            "remote_limit_exceeded",
            "remote_validation",
            "requirements_unmet",
            "response_invalid",
            "service_error",
            "service_not_configured",
            "tls_error",
            "transport_error",
            "usage_error"
          ],
          "exit_codes": {
            "0": "success",
            "2": "input or configuration error",
            "3": "authentication or keyring error",
            "4": "unmet requirement (nothing was written), or config drift/unverified",
            "5": "remote validation error, not found, or conflict",
            "6": "transport, TLS, or service failure, or unknown write outcome",
            "7": "confirmed partial write"
          }
